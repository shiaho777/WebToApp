# WebToApp — example environment configuration.
# Copy to `.env` and fill in as needed. Every variable is OPTIONAL; sensible
# defaults apply when unset. Do NOT commit your real `.env`.

# ---------- Public URL ----------
# Public origin of this server (e.g. https://app.example.com). Used as the iOS
# Web Clip launcher target so the app's URL can be hot-swapped later without
# reinstalling. If unset, it is inferred from the request Host header
# (fine for local dev, but iPhones can't open "localhost").
PUBLIC_BASE_URL=

# ---------- Android build ----------
# Default Android package prefix; the per-app id is appended automatically.
ANDROID_PACKAGE_PREFIX=com.webtoapp
# Directory holding per-app signing keystores (one cert per app). Keep this
# OUTSIDE any publicly served path. Defaults to certs/app-keys.
ANDROID_KEYSTORE_DIR=
# Password for the internal template-build keystore only (not security
# critical — the template is re-signed per app). Defaults to "android".
ANDROID_TEMPLATE_KEYSTORE_PASSWORD=
# Android SDK location (usually auto-detected). Set if build tools aren't found.
ANDROID_HOME=
ANDROID_SDK_ROOT=

# ---------- Build quota / abuse control ----------
# Per device-fingerprint daily build limit. 0 disables the quota.
DAILY_BUILD_QUOTA=10
# Parallel distill workers. Increase cautiously on multi-core machines.
DISTILL_WORKER_COUNT=2
# Concurrent platform builders within a single job (1-5).
BUILD_PARALLELISM=4
# Icon fetch timeout seconds and max concurrent candidates.
ICON_FETCH_TIMEOUT=4
ICON_CANDIDATE_LIMIT=6
# Max in-memory recipe cache entries before least-recently-used eviction.
RECIPE_CACHE_SIZE=512
# Comma-separated proxy CIDRs allowed to supply X-Forwarded-* headers.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# ---------- iOS .mobileconfig signing (optional) ----------
# Provide a public-CA SSL cert to sign Web Clip profiles so iOS shows your
# domain instead of "Unsigned". You can also drop files into certs/ as
# ios-cert.pem / ios-key.pem / ios-chain.pem instead of setting these.
IOS_CERT_FILE=
IOS_KEY_FILE=
IOS_CHAIN_FILE=

# ---------- Cloudflare R2 offload (optional) ----------
# Set ALL of these to mirror download artifacts to R2 and 302-redirect
# downloads to the CDN, saving origin bandwidth.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ---------- Cloudflare cache purge (optional) ----------
# When set, changing an app's target URL eagerly purges the cached redirect.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Seconds the iOS /launch 302 may be cached at the edge (lower = faster swap).
LAUNCH_CACHE_MAX_AGE=60

# ---------- Outbound fetch guardrails ----------
# Max bytes read from analyzed pages, icon fetches, and manifests.
OUTBOUND_RESPONSE_MAX_BYTES=4194304
# Max redirect hops followed for analysis and icon discovery.
OUTBOUND_REDIRECT_LIMIT=4

# ---------- HTML-to-App uploads ----------
# Max accepted upload size for .html / .zip HTML app sources.
HTML_UPLOAD_MAX_BYTES=10485760
# Max total uncompressed size of an extracted zip site bundle.
HTML_SITE_MAX_UNCOMPRESSED_BYTES=20971520
# Max number of files inside an uploaded zip site bundle.
HTML_SITE_MAX_FILE_COUNT=500
# Max total site size embedded in an exported history snapshot (larger sites
# are skipped from the export and flagged instead).
HTML_EXPORT_MAX_BYTES=2097152

# ---------- Ops ----------
# Shared secret for GET /api/metrics (Authorization: Bearer <token> or
# X-Metrics-Token). When unset, /api/metrics is restricted to loopback
# callers instead of being publicly readable.
METRICS_TOKEN=
# Public origin that serves uploaded HTML-app content (/a/<id>/site/), e.g.
# https://s.example.com (proxied to the same backend). When set, uploaded
# pages execute on this isolated host and the main origin 301-redirects
# /a/<id>/site/ there, so hostile uploaded JS cannot call the API with
# visitor cookies. STRONGLY RECOMMENDED in production: when empty, serving
# uploaded content fails closed with 503 (see SITE_ALLOW_SAME_ORIGIN).
SITE_PUBLIC_BASE_URL=
# Explicit opt-in to legacy same-origin hosting when SITE_PUBLIC_BASE_URL is
# empty. DANGEROUS: uploaded JS runs same-origin with the API and can read
# the device fingerprint cookie and localStorage edit tokens. Only for
# local development. Default: unset (fail closed).
SITE_ALLOW_SAME_ORIGIN=
# Shared secret presented by the site gateway (e.g. the Cloudflare Worker
# fronting SITE_PUBLIC_BASE_URL) in X-Site-Origin-Key. Required for the
# gateway to fetch /a/<id>/site/ content without being 301-redirected.
SITE_ORIGIN_KEY=
